# Local rustup home used for cross-target `cargo check` verification
.rustup-home/

# Generated plugin fixture manifests/artifacts
examples/plugin-demo/build/
examples/plugin-multi-export/build/
examples/provider-demo/build/

# Release artifacts
dist/

# Local VM/QEMU tooling and disk images
.tools/

# Local-only credentials and environment files
.secrets/
.env.local

# stdlib product test output
stdlib/tests/out/

# Python tooling caches and perf capture files
__pycache__/
*.pyc
.perf-out-*
.perf-err-*
