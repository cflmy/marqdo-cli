{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marqdo.dev/schemas/extension-evidence-v1.json",
  "title": "Marqdo external-extension evidence manifest",
  "description": "SHA-bound evidence that independent repositories can use the frozen CLI without modifying or recompiling marqdo-cli (RFC-EXT-0001 §11.3). Generated by tools/ci/verify_extension_contracts.py; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "tested_sha",
    "cli_binary_sha256",
    "fixture_repo_sha",
    "os",
    "arch",
    "results",
    "commands",
    "failures",
    "unverified"
  ],
  "properties": {
    "schema": { "const": "marqdo.extension-evidence" },
    "schema_version": { "const": 1 },
    "tested_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact marqdo-cli source commit the frozen binary was built from."
    },
    "cli_binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_worker_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_applications": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "const": "PASS" }
    },
    "fixture_repo_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "os": { "type": "string", "enum": ["linux", "macos", "windows"] },
    "arch": { "type": "string" },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "FAIL", "UNSUPPORTED", "SKIPPED"]
      },
      "required": [
        "callable_registry",
        "plugin_worker",
        "foreign_kernel",
        "resource_provider_cli",
        "package_pinned_git",
        "tool_analysis_consumer",
        "negative_security"
      ]
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "failures": { "type": "array", "items": { "type": "string" } },
    "unverified": { "type": "array", "items": { "type": "string" } }
  }
}
